# 이 파일을 backend/.env로 복사해서 값을 채움 (git에 올리지 않음)
# 환경 변수(App Service 앱 설정)가 있으면 그 값을 먼저 쓰고, 없는 이름만 backend/.env에서 읽음
# 프론트엔드 개발 서버 주소 (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:5173
# 아래 값이 비어 있으면 대화는 내장 대본, 개인정보 가리기는 로컬 규칙, 안전 검사는 통과로 동작함
# 엔드포인트는 https://<리소스이름>.openai.azure.com 처럼 끝에 경로 없이 적음
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
# true면 안전 서비스가 빠지거나 실패할 때 모델을 부르지 않고 그림 선택으로 돌아감 (배포 권장).
# 비우면 false: PII가 없거나 실패하면 로컬 규칙으로 가려 계속, Content Safety 키가 없으면 통과 (로컬·시연)
AI_SAFETY_REQUIRED=
# 저장소: memory(기본값, 서버를 끄면 비워짐) 또는 cosmos. cosmos면 아래 세 값이 필요함
STORE=
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=
# 보호자 로그인 토큰(JWT) 비밀키. 비어 있으면 로그인 없이 기기 기록으로만 동작함
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Azure AI Speech (한국어 STT·TTS). 키는 여기(서버)에만. 브라우저는 /speech/token의 10분짜리 토큰만 받음.
# 비어 있으면 /speech/status가 available false → 아이 화면은 기기 안 인식·브라우저 음성 그대로
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# 비우면 ko-KR-SunHiNeural
AZURE_SPEECH_VOICE=
# true면 검수 전 감정 초안(content/drafts: 두려움·혐오·무표정)을 합침. 미리보기·검수용 (아이용 배포에서는 비움)
CONTENT_DRAFTS=
